{
  "apiVersion": "v1",
  "kind": "List",
  "items": [
    {
      "apiVersion": "v1",
      "kind": "Service",
      "metadata": {"name": "ranks"},
      "spec": {
        "clusterIP": "None",
        "publishNotReadyAddresses": true,
        "selector": {"app": "training-ddp"},
        "ports": [{"name": "rendezvous", "port": 29500}]
      }
    },
    {
      "apiVersion": "batch/v1",
      "kind": "Job",
      "metadata": {"name": "training-ddp"},
      "spec": {
        "completionMode": "Indexed",
        "completions": 2,
        "parallelism": 2,
        "backoffLimit": 0,
        "activeDeadlineSeconds": 180,
        "template": {
          "metadata": {"labels": {"app": "training-ddp"}},
          "spec": {
            "restartPolicy": "Never",
            "automountServiceAccountToken": false,
            "subdomain": "ranks",
            "nodeSelector": {"infraguide-role": "ddp"},
            "affinity": {
              "podAntiAffinity": {
                "requiredDuringSchedulingIgnoredDuringExecution": [
                  {
                    "labelSelector": {"matchLabels": {"app": "training-ddp"}},
                    "topologyKey": "kubernetes.io/hostname"
                  }
                ]
              }
            },
            "containers": [
              {
                "name": "trainer",
                "image": "infra-guide/kubernetes-gloo-job:v1",
                "imagePullPolicy": "Never",
                "command": ["python", "-B", "/rank_step.py"],
                "ports": [{"name": "rendezvous", "containerPort": 29500}],
                "resources": {"requests": {"cpu": "100m", "memory": "256Mi"}},
                "env": [
                  {"name": "WORLD_SIZE", "value": "2"},
                  {"name": "MASTER_ADDR", "value": "training-ddp-0.ranks"},
                  {"name": "MASTER_PORT", "value": "29500"},
                  {"name": "GLOO_SOCKET_IFNAME", "value": "eth0"},
                  {"name": "POD_IP", "valueFrom": {"fieldRef": {"fieldPath": "status.podIP"}}},
                  {"name": "NODE_NAME", "valueFrom": {"fieldRef": {"fieldPath": "spec.nodeName"}}}
                ]
              }
            ]
          }
        }
      }
    }
  ]
}
